VITE_API_BASE_URL=http://localhost:5100/api/v1

# Pusher (Channels) app key - get it from https://dashboard.pusher.com,
# "App Keys" tab of your app (the public key, safe to expose in client
# code - channel auth for private channels happens server-side). Optional -
# without these, the app falls back to its existing polling instead of
# realtime order updates.
VITE_PUSHER_KEY=replace_with_your_pusher_key
VITE_PUSHER_CLUSTER=ap2

# Google Maps JavaScript API key - get it from https://console.cloud.google.com
# (create a project, enable "Maps JavaScript API" and "Places API", enable
# billing, then create a key under APIs & Services > Credentials). Public,
# safe to expose in client code (restrict it to your domain(s) in the
# Google Cloud Console). Powers the map-based delivery address picker.
# Without it, address entry falls back to the plain text form fields.
VITE_GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key
