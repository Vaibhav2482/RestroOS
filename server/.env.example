PORT=5100
NODE_ENV=development

# New, separate Postgres database - do NOT reuse ChaiChakhna's Neon database.
# Free at https://neon.tech (create a new project for RestroOS).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_SSL=true

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional - get a DSN from https://sentry.io (create a Node project).
# Without it, unexpected 500s are still logged to the console (as they
# always were) but nowhere else - nothing pages anyone or shows up in a
# dashboard until this is set.
SENTRY_DSN=replace_with_your_sentry_dsn

# One-time bootstrap of the first platform admin account (yourself):
# POST http://localhost:5100/api/v1/platform-admin/auth/bootstrap
# { "fullName": "...", "email": "...", "password": "..." }
# Only works while zero platform admins exist - refuses after the first one.

# Razorpay test-mode keys - get these from https://dashboard.razorpay.com/app/keys
# (toggle to "Test Mode" first). Used for the Card/UPI checkout demo only;
# Cash orders never touch Razorpay.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# Optional but recommended - a payment succeeding server-side no longer
# depends on the customer's browser staying online long enough to call back
# afterward. Create a webhook in the Razorpay Dashboard (Settings > Webhooks)
# pointing at https://<your-api-domain>/api/v1/payments/webhook, subscribed
# to the "order.paid" event, and paste its signing secret here. Without this,
# payments still work via the existing client-side verify call alone.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_signing_secret

# Pusher (Channels) - get these from https://dashboard.pusher.com, "App Keys"
# tab of your app. Powers realtime order push (new orders, status changes)
# to tenant-admin/POS and the storefront order-tracking page. Optional -
# without these the app falls back to its existing polling.
PUSHER_APP_ID=replace_with_your_pusher_app_id
PUSHER_KEY=replace_with_your_pusher_key
PUSHER_SECRET=replace_with_your_pusher_secret
PUSHER_CLUSTER=ap2

# Resend - get an API key from https://resend.com/api-keys. Powers order
# confirmation/status/cancellation emails to customers. Optional - without
# it, orders still work, customers just don't get emailed. NOTIFICATION_FROM_EMAIL
# defaults to Resend's own onboarding@resend.dev sender if unset (works
# without verifying a custom domain, fine for testing).
RESEND_API_KEY=replace_with_your_resend_api_key
NOTIFICATION_FROM_EMAIL=RestroOS <onboarding@resend.dev>

# Optional - included as a login link in the owner-credential emails sent on
# tenant onboarding and password reset. Without it, those emails just skip
# the link and tell the owner to go to their restaurant's admin dashboard.
TENANT_ADMIN_URL=https://admin.restroos.app

# Twilio - get Account SID/Auth Token from https://console.twilio.com. Powers
# the same order notifications as SMS and WhatsApp, alongside email above -
# each channel is independent and optional; unset any of these and that one
# channel is silently skipped.
# SMS: TWILIO_SMS_FROM_NUMBER is a Twilio phone number you've purchased,
# in E.164 format (e.g. +15551234567).
# WhatsApp: TWILIO_WHATSAPP_FROM_NUMBER is your Twilio WhatsApp sender -
# during testing this is Twilio's sandbox number (+14155238886, join it by
# sending the sandbox's join code to it from WhatsApp); a real customer-facing
# number requires Meta Business verification, which is a separate, slower
# process to apply for.
TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_SMS_FROM_NUMBER=+15551234567
TWILIO_WHATSAPP_FROM_NUMBER=+14155238886

# WhatsApp business-initiated messages (which an order notification always
# is) require a pre-approved Content Template, not free-form text - create
# one per message type below in the Twilio Console (Content Template
# Builder) or Meta Business Manager, get it approved, then paste its
# ContentSid (starts with "HX") here. Any of these left unset just means
# that specific message type won't go out over WhatsApp - email/SMS for it
# still do.
#
# ORDER_CONFIRMED, ORDER_DELIVERED, and ORDER_CANCELLED include the
# itemized bill as a single flattened-text variable (WhatsApp templates
# don't support a repeating/looping section, so the whole item list is
# passed as one multi-line string) - STATUS_CHANGED is just a short ping
# for every other status (Accepted/Preparing/Ready/Out For Delivery),
# deliberately without the bill so it isn't repeated on every step.
# Suggested template bodies (matching what the code fills in):
#   ORDER_CONFIRMED:  "Hi {{1}}, your order #{{2}} has been placed!\n\n{{3}}\n\nTotal: {{4}}\nWe'll update you as it moves through the kitchen."
#   STATUS_CHANGED:   "Hi {{1}}, your order #{{2}} is now {{3}}."
#   ORDER_DELIVERED:  "Hi {{1}}, your order #{{2}} has been delivered!\n\n{{3}}\n\nTotal: {{4}}\nThank you for ordering with us!"
#   ORDER_CANCELLED:  "Hi {{1}}, your order #{{2}} has been cancelled.\n\n{{3}}\n\n{{4}}"
TWILIO_WHATSAPP_TEMPLATE_ORDER_CONFIRMED=replace_with_your_content_sid
TWILIO_WHATSAPP_TEMPLATE_STATUS_CHANGED=replace_with_your_content_sid
TWILIO_WHATSAPP_TEMPLATE_ORDER_DELIVERED=replace_with_your_content_sid
TWILIO_WHATSAPP_TEMPLATE_ORDER_CANCELLED=replace_with_your_content_sid
